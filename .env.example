# Person 1: Responsible for environment setup and runtime configuration.
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=crypto_settlement_platform
DB_PORT=3306

SESSION_SECRET=replace_with_strong_secret

# Optional. If unset, app falls back to public Sepolia RPC.
ALCHEMY_RPC_URL=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SECRET=your_webhook_secret_here

CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_ABI=[]
PAYMENT_GATEWAY_TREASURY=
PRIVATE_KEY=replace_with_testnet_deployer_private_key
SEPOLIA_EXPLORER_BASE_URL=https://sepolia.etherscan.io

COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Optional. If unset, settlement workflow uses local fallback service.
N8N_WEBHOOK_URL=
N8N_API_KEY=
# Optional in non-production. Internal verify route is open in development when unset.
INTERNAL_API_KEY=

PLATFORM_FEE_PERCENTAGE=1.0
CONVERSION_FEE_PERCENTAGE=0.5
SEPOLIA_CHAIN_ID=11155111
MIN_CONFIRMATIONS=12
