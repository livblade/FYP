<!-- Person 4: Responsible for audit log review UI. -->
<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Audit Logs</h1>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>User</th>
              <th>Action</th>
              <th>Entity</th>
              <th>IP Address</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs && logs.length) { %>
              <% logs.forEach(log => { %>
                <tr>
                  <td><%= new Date(log.created_at).toLocaleString() %></td>
                  <td>
                    <% if (log.User) { %>
                      <span title="<%= log.User.email %>"><%= log.User.name %></span>
                    <% } else if (log.user_id) { %>
                      <span class="text-muted">User #<%= log.user_id %></span>
                    <% } else { %>
                      <span class="text-muted">System</span>
                    <% } %>
                  </td>
                  <td><code class="small"><%= log.action %></code></td>
                  <td>
                    <span class="text-muted"><%= log.entity_type %></span>
                    <% if (log.entity_id) { %>
                      #<%= log.entity_id %>
                    <% } %>
                  </td>
                  <td><%= log.ip_address || 'N/A' %></td>
                  <td>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#logModal" data-log-details="<%= JSON.stringify(log) %>">
                      View
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center text-muted">No audit logs found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <nav aria-label="Audit Log Pagination">
          <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
            </li>
            <% for(let i = 1; i <= totalPages; i++) { %>
              <li class="page-item <%= i === currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
            </li>
          </ul>
        </nav>
      <% } %>
    </div>
  </div>
</main>

<!-- Modal for Log Details -->
<div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="logModalLabel">Log Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <pre><code id="logDetailsContent" class="language-json"></code></pre>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var logModal = document.getElementById('logModal');
  logModal.addEventListener('show.bs.modal', function (event) {
    var button = event.relatedTarget;
    var logDetails = JSON.parse(button.getAttribute('data-log-details'));
    var modalBodyCode = logModal.querySelector('#logDetailsContent');
    modalBodyCode.textContent = JSON.stringify(logDetails, null, 2);
  });
});
</script>

<%- include('../partials/footer') %>