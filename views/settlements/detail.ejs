<!-- Person 4: Responsible for settlement detail views and audit summaries. -->
<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4">
  <% if (!settlement) { %>
    <div class="alert alert-warning">Settlement not found.</div>
  <% } else { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <h1 class="h4">Settlement Detail</h1>
      <p>Reference: <strong><%= settlement.settlement_reference %></strong></p>
      <p>Status: <span class="badge bg-secondary"><%= settlement.status %></span></p>
      <% if (isAdmin) { %>
        <p>Merchant ID: <strong><%= settlement.merchant_id %></strong></p>
      <% } %>
      <p>Payment ID: <strong><%= settlement.payment_id %></strong></p>
      <p>Gross amount: SGD <strong><%= Number(settlement.gross_amount_sgd).toFixed(2) %></strong></p>
      <p>Platform fee: SGD <strong><%= Number(settlement.platform_fee_sgd).toFixed(2) %></strong></p>
      <p>Conversion fee: SGD <strong><%= Number(settlement.conversion_fee_sgd).toFixed(2) %></strong></p>
      <p>Net amount: SGD <strong><%= Number(settlement.net_amount_sgd).toFixed(2) %></strong></p>
      <% if (settlement.provider_reference) { %>
        <p>Provider reference: <strong><%= settlement.provider_reference %></strong></p>
      <% } %>
      <% if (settlement.payout_address) { %>
        <p>Payout address: <code><%= settlement.payout_address %></code></p>
      <% } %>
      <% if (settlement.failure_reason) { %>
        <p>Failure reason: <strong><%= settlement.failure_reason %></strong></p>
      <% } %>
      <p>Created at: <strong><%= new Date(settlement.created_at).toLocaleString() %></strong></p>
      <% if (isAdmin) { %>
        <hr />
        <form action="/settlements/<%= settlement.settlement_reference %>/status" method="post" class="row g-2 align-items-end">
          <div class="col-md-3">
            <label class="form-label small text-muted" for="settlementStatus">Status</label>
            <select class="form-select form-select-sm" id="settlementStatus" name="status">
              <% (statusOptions || []).forEach((status) => { %>
                <option value="<%= status %>" <%= status === settlement.status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted" for="failureReason">Failure reason</label>
            <input class="form-control form-control-sm" id="failureReason" name="failure_reason" value="<%= settlement.failure_reason || '' %>" />
          </div>
          <div class="col-md-3">
            <button class="btn btn-primary btn-sm w-100" type="submit">Update Status</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
