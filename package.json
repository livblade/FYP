{
  "name": "crypto-settlement-platform",
  "version": "0.1.0",
  "description": "Draft scaffold for a cryptocurrency payment acceptance and auto-settlement platform.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "npm run test:verification && npm run test:integration && npm run test:contract",
    "mock:n8n": "node scripts/mockN8nServer.js",
    "db:apply-prompt-schema": "node scripts/applyPromptSchema.js",
    "db:verify": "node scripts/verifyDatabase.js",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "test:verification": "mocha tests/unit/verificationService.test.js",
    "test:contract": "cd blockchain && hardhat test",
    "deploy:sepolia": "cd blockchain && hardhat run scripts/deploy.js --network sepolia",
    "abi:payment-gateway": "cd blockchain && hardhat compile && node scripts/exportPaymentGatewayAbi.js"
  },
  "keywords": [
    "crypto",
    "payments",
    "settlement",
    "express",
    "ejs"
  ],
  "author": "Team Project",
  "license": "MIT",
  "dependencies": {
    "@alch/alchemy-sdk": "^1.1.1",
    "@openzeppelin/contracts": "^5.6.1",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "ethers": "^6.9.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^4.5.0",
    "hardhat": "^2.26.2",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.4"
  }
}
